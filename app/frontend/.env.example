# Frontend configuration — copy to .env.local for local dev, or set these in
# the Vercel dashboard for production.
#
# Everything here is PUBLIC. Vite inlines VITE_* values into the built bundle,
# so anyone can read them in the browser. Never put a service_role key, a
# database password, or a Mapbox sk. token in this file.

# Supabase project URL and ANON key. The anon key is designed to be public —
# it is protected by row-level security, not by secrecy.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Where the FastAPI backend lives.
#   local dev : http://127.0.0.1:8000
#   production: your Render service URL, e.g. https://bizleads-api.onrender.com
# Whatever you set here must also appear in the backend's ALLOWED_ORIGINS,
# or the browser will block every call.
VITE_API_BASE_URL=http://127.0.0.1:8000
