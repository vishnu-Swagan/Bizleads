# Backend configuration — copy to ../.env for local dev, or set these in the
# Render dashboard for production. Never commit the filled-in version.
#
# Locally the app reads app/.env (one level above this file); main.py loads it
# at startup.

# ─── Database ─────────────────────────────────────────────────────────────
# Use the Supabase SUPAVISOR POOLER host, NOT db.<ref>.supabase.co.
# The direct host resolves to IPv6 only and is unreachable from most networks
# and from Render. Session mode (:5432) suits a long-lived process;
# transaction mode (:6543) is for serverless.
#
# The password MUST be percent-encoded: @ -> %40, $ -> %24, / -> %2F, : -> %3A
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<url-encoded-password>@aws-1-eu-west-2.pooler.supabase.com:5432/postgres

# ─── Supabase auth ────────────────────────────────────────────────────────
# Tokens are verified against the project's published ES256 JWKS. There is no
# shared secret to configure — the backend holds only public key material.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Only for projects still on legacy symmetric (HS256) signing. Leave unset when
# SUPABASE_JWKS_URL is present — asymmetric verification is preferred.
# SUPABASE_JWT_SECRET=

# ─── CORS ─────────────────────────────────────────────────────────────────
# MUST list the deployed frontend origin, comma-separated, or every browser
# call fails. A bare "*" is rejected at startup with a logged warning: combined
# with credentialed requests it would reopen the any-origin hole this codebase
# was audited for.
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ─── Providers ────────────────────────────────────────────────────────────
# Use a PUBLIC pk. token, restricted by URL in the Mapbox dashboard.
# Never an sk. secret token — those can manage the whole Mapbox account.
MAPBOX_ACCESS_TOKEN=pk.your_public_token

# Optional. Without it, website quality stays on the free heuristic tier
# (measured from the page the app already fetches). With it, scores come from
# real Lighthouse audits. The key itself is free — no billing card required.
# PAGESPEED_API_KEY=

# ─── Runtime ──────────────────────────────────────────────────────────────
# Must NOT be "dev" in production: the exception handler returns full stack
# traces when it is.
ENVIRONMENT=production

# Legacy Atoms Cloud auth. Only needed while migrating; once the frontend is
# fully on Supabase these can be removed along with the fallback path.
# JWT_SECRET_KEY=
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=720

# ─── Deliberately absent ──────────────────────────────────────────────────
# into the database. Leave unset in production.
#
# STRIPE_SECRET_KEY — billing has no webhook yet, so a customer who cancels in
# Stripe keeps access indefinitely. Do not enable payments until that exists.

# --- Outreach email (SMTP) ---
# Leave unset to run without email; the outreach endpoints return 503 and the
# UI reports email as not configured. Nothing else is affected.
#
# For Gmail, SMTP_PASSWORD must be an App Password, not the account password:
#   1. Turn on 2-Step Verification for the account
#   2. Create one at https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters (spaces are stripped automatically)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Outreach email via Resend (alternative to SMTP) ---
# Setting RESEND_API_KEY switches delivery to Resend automatically.
# Requires a verified sending domain in the Resend dashboard; until then it
# only delivers to the account owner's own address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
