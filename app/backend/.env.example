# Backend configuration — copy to ../.env for local dev, or set these in the
# Render dashboard for production. Never commit the filled-in version.
#
# Locally the app reads app/.env (one level above this file); main.py loads it
# at startup.

# ─── Database ─────────────────────────────────────────────────────────────
# Use the Supabase SUPAVISOR POOLER host, NOT db.<ref>.supabase.co.
# The direct host resolves to IPv6 only and is unreachable from most networks
# and from Render. Session mode (:5432) suits a long-lived process;
# transaction mode (:6543) is for serverless.
#
# The password MUST be percent-encoded: @ -> %40, $ -> %24, / -> %2F, : -> %3A
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<url-encoded-password>@aws-1-eu-west-2.pooler.supabase.com:5432/postgres

# ─── Supabase auth ────────────────────────────────────────────────────────
# Tokens are verified against the project's published ES256 JWKS. There is no
# shared secret to configure — the backend holds only public key material.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Only for projects still on legacy symmetric (HS256) signing. Leave unset when
# SUPABASE_JWKS_URL is present — asymmetric verification is preferred.
# SUPABASE_JWT_SECRET=

# ─── CORS ─────────────────────────────────────────────────────────────────
# MUST list the deployed frontend origin, comma-separated, or every browser
# call fails. A bare "*" is rejected at startup with a logged warning: combined
# with credentialed requests it would reopen the any-origin hole this codebase
# was audited for.
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ─── Providers ────────────────────────────────────────────────────────────
# Use a PUBLIC pk. token, restricted by URL in the Mapbox dashboard.
# Never an sk. secret token — those can manage the whole Mapbox account.
MAPBOX_ACCESS_TOKEN=pk.your_public_token

# Primary business discovery source. Restrict this key to Places API (New) in
# Google Cloud. MapBox remains the fallback when this is unset or returns no
# usable businesses.
GOOGLE_PLACES_API_KEY=

# Optional. Without it, website quality stays on the free heuristic tier
# (measured from the page the app already fetches). With it, scores come from
# real Lighthouse audits. The key itself is free — no billing card required.
# PAGESPEED_API_KEY=

# ─── Runtime ──────────────────────────────────────────────────────────────
# Must NOT be "dev" in production: the exception handler returns full stack
# traces when it is.
ENVIRONMENT=production

# Legacy Atoms Cloud auth. Only needed while migrating; once the frontend is
# fully on Supabase these can be removed along with the fallback path.
# JWT_SECRET_KEY=
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=720

# ─── Scheduled automations ────────────────────────────────────────────────
# A long random value: `openssl rand -hex 32`. The SAME value must be set as a
# GitHub repository secret named AUTOMATION_CRON_SECRET, so
# .github/workflows/run-automations.yml can trigger due automations hourly.
# Render's free tier has no cron and sleeps when idle, so without this nothing
# fires a schedule and automations run only when a human presses the button.
#
# Unset, /api/v1/automations/run-scheduled returns 401 and nothing runs — the
# correct failure. Scheduled runs never send email; they search, qualify and
# draft into the approval queue only.
AUTOMATION_CRON_SECRET=

# ─── Deliberately absent ──────────────────────────────────────────────────
# SEED_MOCK_DATA is gone. The seeder and its eight fabricated sample leads were
# deleted outright, along with the AI business generator, so there is no
# variable to set. tests/test_discovery.py::test_the_fabrication_path_does_not_exist
# fails if either returns.

# --- Outreach email (SMTP) ---
# NO LONGER USED FOR SENDING. Every account — including the operator's —
# configures its own Gmail or Resend credentials in Settings, encrypted at rest
# under CREDENTIAL_ENCRYPTION_KEY below.
#
# These were once the operator's account, used as a fallback for workspaces
# that had configured nothing. That meant those customers sent outreach from
# the operator's address: complaints against the operator's domain, replies
# into the operator's inbox, and a customer named as legal sender of mail from
# an address they do not own. Leave unset.
# Leave unset to run without email; the outreach endpoints return 503 and the
# UI reports email as not configured. Nothing else is affected.
#
# For Gmail, SMTP_PASSWORD must be an App Password, not the account password:
#   1. Turn on 2-Step Verification for the account
#   2. Create one at https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters (spaces are stripped automatically)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Outreach email via Resend (alternative to SMTP) ---
# Setting RESEND_API_KEY switches delivery to Resend automatically.
# Requires a verified sending domain in the Resend dashboard; until then it
# only delivers to the account owner's own address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Customer email credentials ---
# Encrypts each customer's stored SMTP password / API key at rest.
# Nothing can be saved without it; there is deliberately no plaintext fallback.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating it invalidates every stored credential.
CREDENTIAL_ENCRYPTION_KEY=

# --- Stripe billing ---
# Without STRIPE_WEBHOOK_SECRET the webhook fails closed with a 503, and
# payments then succeed without activating anything: a customer who closes the
# tab after paying is never activated, renewals never reset credits, and
# cancellations never revoke access. Get the secret from the Stripe dashboard
# when adding the endpoint https://<your-api>/api/v1/payments/webhook.
#
# Subscribe that endpoint to exactly the six events the handler acts on
# (routers/stripe_webhook.py HANDLED_EVENTS); anything else is acknowledged
# and ignored:
#   checkout.session.completed, customer.subscription.created,
#   customer.subscription.updated, customer.subscription.deleted,
#   invoice.paid, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI writing assistance (optional) ---
# Improves the wording of drafts. Never adds facts: the model receives only
# measured findings and the user's text. Without this key the deterministic
# composer still writes every draft.
# Either provider works; Anthropic is preferred when both are set.
ANTHROPIC_API_KEY=
# NVIDIA NIM — free tier at build.nvidia.com, OpenAI-compatible.
NVIDIA_API_KEY=
NVIDIA_MODEL=
